{
    "manifest_version": 3,
    "name": "Skip Transfer",
    "version": "1.0.0",
    "description": "跳过各种网页的中转页",
    "permissions": [
        "storage",
        "sidePanel",
        "tabs",
        "scripting"
    ],
    "side_panel": {
        "default_path": "sidebar.html"
    },
    "icons": {
        "16": "./imgs/icons/icon16.png",
        "48": "./imgs/icons/icon48.png",
        "128": "./imgs/icons/icon128.png"
    },
    "action": {
        "default_title": "打开中转页设置页面",
        "default_icon": "./imgs/icons/icon48.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}